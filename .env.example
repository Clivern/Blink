# DigitalOcean Container Registry image
BLINK_IMAGE=registry.digitalocean.com/blink/blink:main

# Public URL (used in emails, billing redirects, etc.)
BLINK_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blink

# Nginx
NGINX_HTTP_PORT=80

# Optional: AI, mail, GitHub/Google OAuth
# BLINK_AI_PROVIDER=openrouter
# BLINK_AI_API_KEY=
# BLINK_AI_CHAT_MODEL=openai/gpt-4o
# BLINK_RESEND_API_KEY=
# BLINK_GITHUB_OAUTH_CLIENT_ID=
# BLINK_GITHUB_OAUTH_CLIENT_SECRET=
# BLINK_GITHUB_OAUTH_REDIRECT_URL=
# BLINK_GOOGLE_OAUTH_CLIENT_ID=
# BLINK_GOOGLE_OAUTH_CLIENT_SECRET=
# BLINK_GOOGLE_OAUTH_REDIRECT_URL=
